  "major_runtime_chains": [
    {
      "name": "Sales to service setup",
      "workflow_graph": "Sales",
      "chain": [
        "Sales lead intake workers",
        "Onboarding Typeform worker",
        "Year derivation worker",
        "BTW dealstage by bank connection worker",
        "IB machtiging actief worker"
      ],
      "runtime_pattern": "New customer state creates service deals, year context and initial pipeline/stage signals."
    },
    {
      "name": "Bank connection to BTW routing",
      "workflow_graph": "BTW",
      "chain": [
        "Portal bank connection status worker",
        "BTW dealstage by bank connection worker",
        "Berekening compleet worker",
        "BTW finished assignment propagation worker"
      ],
      "runtime_pattern": "Company bank status drives BTW stage routing and eventually finished-work assignment propagation."
    },
    {
      "name": "BTW quarter memory",
      "workflow_graph": "BTW",
      "chain": [
        "BTW dealstage by bank connection worker",
        "BTW next-quarter two-month propagation worker",
        "BTW dealstage by bank connection worker"
      ],
      "runtime_pattern": "A quarter writes operational memory into the next quarter, which changes the next quarter's routing."
    },
    {
      "name": "BTW to JR to IB readiness",
      "workflow_graph": "BTW -> JR -> IB",
      "chain": [
        "BTW dealstage by bank connection worker",
        "JR stage from booked BTW quarters worker",
        "IB kan gemaakt worden from JR worker",
        "IB route after typeform and machtiging worker"
      ],
      "runtime_pattern": "BTW progress makes JR ready; JR readiness makes IB possible."
    },
    {
      "name": "IB prerequisites to VA IB",
      "workflow_graph": "IB -> VA",
      "chain": [
        "Typeform IB completion worker",
        "IB machtiging actief worker",
        "IB kan gemaakt worden from JR worker",
        "IB route after typeform and machtiging worker",
        "VA IB coordination workers"
      ],
      "runtime_pattern": "IB input, mandate and JR readiness converge into IB stage routing and VA IB coordination."
    },
    {
      "name": "IB pulls JR priority",
      "workflow_graph": "IB -> JR",
      "chain": [
        "Typeform IB completion worker",
        "IB machtiging actief worker",
        "IB kan gemaakt worden from JR worker",
        "JR priority from IB worker",
        "IB kan gemaakt worden from JR worker"
      ],
      "runtime_pattern": "IB readiness can bump JR priority, and JR changes can then re-evaluate IB readiness."
    },
    {
      "name": "VA VPB annual coordination",
      "workflow_graph": "VPB -> VA -> VPB",
      "chain": [
        "VA VPB coordination workers",
        "VA VPB coordination workers"
      ],
      "runtime_pattern": "VPB finished moves paired VA VPB work forward; VA finished writes va_ingediend back to VPB."
    },
    {
      "name": "Payment block and repair",
      "workflow_graph": "Debtor/payment",
      "chain": [
        "Debtor betaal niet propagation worker",
        "Correct stage repair worker",
        "BTW dealstage by bank connection worker",
        "IB route after typeform and machtiging worker"
      ],
      "runtime_pattern": "Payment status can block many deals; reset or repair can re-enroll them into their original pipeline workflows."
    },
    {
      "name": "Assignment propagation",
      "workflow_graph": "Assignment propagation",
      "chain": [
        "BTW finished assignment propagation worker",
        "IB/JR owner summary workers",
        "JR priority from IB worker"
      ],
      "runtime_pattern": "Owner/controller state propagates across future recurring work and related IB/JR summaries."
    }
  ],
  "orchestration_hubs": [
