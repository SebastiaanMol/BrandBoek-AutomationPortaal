+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+function BreakDiagnosisNode({ step }: { step: InactiveJourneyDiagnosisStep }) {
+  const styles = {
+    "before-break": "border-emerald-200 bg-emerald-50 text-emerald-800",
+    broken: "border-red-200 bg-red-50 text-red-800",
+    "after-break": "border-slate-200 bg-slate-50 text-slate-500 opacity-70",
+  } satisfies Record<InactiveJourneyDiagnosisStep["state"], string>;
+  const statusLabel =
+    step.state === "before-break" ? "Actief" : step.state === "broken" ? "Uitgeschakeld" : "Geraakt";
+
+  return (
+    <div className={`min-h-24 rounded-lg border p-3 lg:w-56 ${styles[step.state]}`}>
+      <p className="text-xs font-bold uppercase">
+        Stap {step.stepNumber} - {statusLabel}
+      </p>
+      <p className="mt-1 text-sm font-semibold leading-snug">
+        {step.automation.naam}
+      </p>
+      {step.state === "after-break" && (
+        <p className="mt-1 text-xs leading-relaxed">
+          Afhankelijk van de kapotte stap.
+        </p>
+      )}
+    </div>
+  );
+}
+
+function getInactiveJourneyDescription(description: string | undefined, typeLabel: string): string {
+  if (!description?.trim()) {
+    return `${typeLabel} met een onderbroken automation. De diagnose hieronder wijst de eerste kapotte stap aan.`;
+  }
+
+  if (containsTechnicalRoute(description)) {
+    return `${typeLabel} met een onderbroken automation. De diagnose hieronder toont waar de procesreis stopt en welke stap hersteld moet worden.`;
+  }
+
+  return description;
+}
+
+function containsTechnicalRoute(value: string): boolean {
+  return /(?:^|\s)\/[a-z0-9_-]+\/|POST\s|GET\s|PATCH\s|endpoint|webhook|api-route/i.test(value);
+}
